{
  "name": "@abox-dev/python-sdk",
  "private": true,
  "version": "0.1.3",
  "scripts": {
    "test": "uv run pytest -n 4 --verbose -x tests/test_*.py tests/shared",
    "test:integration": "uv run pytest -n 4 --verbose -x tests/sync tests/async",
    "postVersion": "uv version $(pnpm pkg get version --workspaces=false | tr -d \\\")",
    "typecheck": "uv run make typecheck",
    "lint": "uv run make lint",
    "format": "uv run make format",
    "format:check": "uv run make lint"
  }
}
